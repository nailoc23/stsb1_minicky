<?xml version="1.0" encoding="UTF-8" ?>
<!-- mapper DTD 선언 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- SQL Mapping -->
<mapper namespace="ManagerDao">
	<select id="selectManagerByIdPw" parameterType="map" resultType="java.lang.Integer">
		SELECT count(id) as cnt FROM manager WHERE id=#{id} and pw=#{pw}
	</select>
</mapper>